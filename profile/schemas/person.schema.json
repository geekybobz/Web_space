{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geekybobz.github.io/Web_space/api/profile/v1/schemas/person.schema.json",
  "title": "Public person profile",
  "type": "object",
  "required": ["display_name", "full_name", "headline", "location", "public_contacts", "visibility"],
  "properties": {
    "$schema": {"type": "string"},
    "display_name": {"type": "string", "minLength": 1},
    "full_name": {"type": "string", "minLength": 1},
    "headline": {"type": "string", "minLength": 1},
    "professional_title": {"type": "string"},
    "location": {
      "type": "object",
      "required": ["city", "country", "country_code"],
      "properties": {
        "city": {"type": "string"},
        "country": {"type": "string"},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}
      },
      "additionalProperties": false
    },
    "public_contacts": {
      "type": "object",
      "required": ["email", "linkedin", "google_scholar", "website"],
      "properties": {
        "email": {"type": "string", "format": "email"},
        "linkedin": {"type": "string", "format": "uri"},
        "google_scholar": {"type": "string", "format": "uri"},
        "website": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "visibility": {"const": "public"}
  },
  "additionalProperties": false
}
