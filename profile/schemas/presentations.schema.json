{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geekybobz.github.io/Web_space/api/profile/v1/schemas/presentations.schema.json",
  "title": "Presentation collection",
  "type": "object",
  "required": ["items"],
  "properties": {
    "$schema": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "event", "date", "location", "title", "authors", "summary", "visibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^presentation\\."},
          "kind": {"enum": ["poster", "talk", "seminar", "workshop"]},
          "event": {"type": "string"},
          "date": {"type": "string"},
          "location": {"type": "string"},
          "title": {"type": "string"},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "project_ref": {"type": "string", "pattern": "^project\\."},
          "teaser": {"type": "string"},
          "summary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "artifact": {
            "type": "object",
            "required": ["url", "label"],
            "properties": {"url": {"type": "string", "format": "uri"}, "label": {"type": "string"}},
            "additionalProperties": false
          },
          "visibility": {"const": "public"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
