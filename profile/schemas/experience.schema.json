{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geekybobz.github.io/Web_space/api/profile/v1/schemas/experience.schema.json",
  "title": "Experience collection",
  "type": "object",
  "required": ["items"],
  "properties": {
    "$schema": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "organization", "start", "status", "summary", "visibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^experience\\."},
          "role": {"type": "string"},
          "organization": {"type": "string"},
          "location": {
            "type": "object",
            "required": ["city", "country"],
            "properties": {"city": {"type": "string"}, "country": {"type": "string"}},
            "additionalProperties": false
          },
          "start": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$"},
          "end": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?$"},
          "status": {"enum": ["ongoing", "completed", "paused"]},
          "specialism": {"type": "string"},
          "summary": {"type": "string"},
          "highlights": {"type": "array", "items": {"type": "string"}},
          "skill_refs": {"type": "array", "items": {"type": "string", "pattern": "^skill\\."}, "uniqueItems": true},
          "visibility": {"const": "public"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
